 extern SceUID net_thid;
 extern volatile int all_is_up;
@@ -19,6 +23,21 @@ extern volatile int net_connected;
 volatile int run;
 
 void __unused _start() __attribute__((weak, alias("module_start")));
+#if GV_MINIMAL == 1
+int __unused module_start(SceSize argc, const void* args)
+{
+    (void)argc;
+    (void)args;
+
+    /* A second plugin in the same SceShell as the stock vitacompanion.
+     * Everything that is not the command server is left to the original: no
+     * input thread, no nosleep, no FTP, no taipool. The less this module does
+     * inside SceShell the less it can break -- and if it fails to load at all,
+     * the stock plugin is untouched and the console stays reachable. */
+    run = 1;
+    return net_start() < 0 ? SCE_KERNEL_START_FAILED : SCE_KERNEL_START_SUCCESS;
+}
+#else
 int __unused module_start(SceSize argc, const void* args)
 {
     int result;
