+/* Hand-rolled rather than strtoul: this build links libk, not a full libc,
+ * and a missing symbol would only show up at link time on a plugin that has to
+ * be right first try. Accepts 0x-prefixed hex or decimal. */
+static unsigned int gv_parse_uint(const char *p) {
+  unsigned int v = 0;
+  int base = 10;
+  if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+    base = 16;
+    p += 2;
+  }
+  for (; *p; p++) {
+    unsigned int d;
+    if (*p >= '0' && *p <= '9')
+      d = (unsigned int)(*p - '0');
+    else if (base == 16 && *p >= 'a' && *p <= 'f')
+      d = (unsigned int)(*p - 'a' + 10);
+    else if (base == 16 && *p >= 'A' && *p <= 'F')
+      d = (unsigned int)(*p - 'A' + 10);
+    else
+      break;
+    v = v * (unsigned int)base + d;
+  }
+  return v;
+}
+
 void cmd_launch(char **arg_list, size_t arg_count, char *res_msg) {
   char uri[32];
+  /* Upstream hardcodes 0x20000 here. An app launched with that flags word is
+   * killed ~14 s later, while the same binary started from its LiveArea bubble
+   * runs as long as it likes -- so the flags word is the variable under test,
+   * and it is settable per command rather than baked in. */
+  int flags = GV_LAUNCH_FLAGS;
+
+  if (arg_count > 2) {
+    flags = (int)gv_parse_uint(arg_list[2]);
+  }
 
   snprintf(uri, 32, "psgm:play?titleid=%s", arg_list[1]);
 
-  if (sceAppMgrLaunchAppByUri(0x20000, uri) < 0) {
+  if (sceAppMgrLaunchAppByUri(flags, uri) < 0) {
     strcpy(res_msg, "Error: cannot launch the app. Is the TITLEID correct?\n");
   } else {
     strcpy(res_msg, "Launched.\n");
   }
 }
 
+/* Other ways into the same place. psgm:play is only one of several launch
+ * entry points, and SceShell does not use it for a bubble -- so if the ~14 s
+ * kill is a property of the launch path rather than of the app, one of these
+ * should behave like the bubble does. Each reports its return value, because
+ * "it launched" and "it returned 0 and did nothing" look identical from here.
+ *
+ *   launchshell  sceAppMgrLaunchAppByName2ForShell -- what SceShell itself uses
+ *   launchname2  sceAppMgrLaunchAppByName2
+ *   launchname   sceAppMgrLaunchAppByName, flags default 0x60000
+ */
+void cmd_launchshell(char **arg_list, size_t arg_count, char *res_msg) {
+  (void)arg_count;
+  SceUID rc = sceAppMgrLaunchAppByName2ForShell(arg_list[1], "", NULL);
+  snprintf(res_msg, 128, "ByName2ForShell rc=0x%08X\n", (unsigned int)rc);
+}
+
+void cmd_launchname2(char **arg_list, size_t arg_count, char *res_msg) {
+  (void)arg_count;
+  int rc = sceAppMgrLaunchAppByName2(arg_list[1], "", NULL);
+  snprintf(res_msg, 128, "ByName2 rc=0x%08X\n", (unsigned int)rc);
+}
+
+void cmd_launchname(char **arg_list, size_t arg_count, char *res_msg) {
+  int flags = 0x60000;
+  if (arg_count > 2)
+    flags = (int)gv_parse_uint(arg_list[2]);
+  int rc = sceAppMgrLaunchAppByName(flags, arg_list[1], "");
+  snprintf(res_msg, 128, "ByName flags=0x%X rc=0x%08X\n", (unsigned int)flags,
+           (unsigned int)rc);
+}
+
 void cmd_reboot(char **arg_list, size_t arg_count, char *res_msg) {
   scePowerRequestColdReset();
   strcpy(res_msg, "Rebooting...\n");
