+int __unused module_stop(SceSize argc, const void* args)
+{
+    (void)argc;
+    (void)args;
+
+    run = 0;
+    sceKernelWaitThreadEnd(net_thid, NULL, NULL);
+    net_end();
+
+    return SCE_KERNEL_STOP_SUCCESS;
+}
+#else
 int __unused module_stop(SceSize argc, const void* args)
 {
     (void)argc;
@@ -79,3 +112,4 @@ int __unused module_stop(SceSize argc, const void* args)
 
